{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Octopus",
  "version": "0.1.0",
  "identifier": "ai.octopus.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Octopus",
        "width": 1320,
        "height": 860,
        "minWidth": 980,
        "minHeight": 640,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 28,
          "y": 28
        },
        "backgroundColor": "#12100E",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "copyright": "Copyright 2026 Octopus AI contributors",
    "shortDescription": "Desktop app for coding agents"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ1RDMyODE5RUVBREREODIKUldTQzNhM3VHU2pUMWF6MU5QcUtoMXpJUTVWOFJROHVPM3RGbTJlZk85ME5NNmx3bWRPV3k5NTMK",
      "endpoints": [
        "https://github.com/SkvorikovCode/Octopus-AI/releases/latest/download/latest.json"
      ]
    }
  }
}
