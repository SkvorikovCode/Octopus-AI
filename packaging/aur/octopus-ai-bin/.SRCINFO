pkgbase = octopus-ai-bin
	pkgdesc = Desktop app for coding agents: parallel agents in isolated git worktrees, your own keys
	pkgver = 0.2.1
	pkgrel = 1
	url = https://github.com/SkvorikovCode/Octopus-AI
	arch = x86_64
	license = Apache-2.0
	license = MIT
	depends = cairo
	depends = dbus
	depends = gdk-pixbuf2
	depends = glib2
	depends = glibc
	depends = gtk3
	depends = hicolor-icon-theme
	depends = libgcc
	depends = libsoup3
	depends = webkit2gtk-4.1
	optdepends = libayatana-appindicator: tray icon while the window is closed
	optdepends = gnome-keyring: keep provider keys in the Secret Service
	optdepends = kwallet: keep provider keys in the Secret Service (KDE)
	provides = octopus-ai
	conflicts = octopus-ai
	noextract = Octopus_0.2.1_amd64.deb
